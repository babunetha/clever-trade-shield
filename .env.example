# Server-side Dhan credentials only.
# Never expose these with VITE_/PUBLIC_ prefixes and never commit real values.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=


# Application authentication. Never use VITE_/PUBLIC_ prefixes.
# Use a random secret of at least 32 characters.
APP_SESSION_SECRET=
# Strong single-operator password; never commit this value.
APP_LOGIN_PASSWORD=

# Optional server-side risk policy overrides.
RISK_MAX_PER_TRADE=500
RISK_MAX_DAILY_LOSS=1000
RISK_MAX_WEEKLY_LOSS=2500
RISK_MAX_TRADES_PER_DAY=3
RISK_MAX_OPEN_POSITIONS=2
