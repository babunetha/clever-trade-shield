# Gemini AI agents (server-side only; never expose this key in the browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-side Dhan credentials only.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Random high-entropy secret appended to the Dhan postback URL.
DHAN_POSTBACK_SECRET=

# Server-side application authentication.
APP_SESSION_SECRET=
APP_LOGIN_PASSWORD_HASH=

# Supabase server-side persistence. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RISK_MAX_PER_TRADE=500
RISK_MAX_DAILY_LOSS=1000
RISK_MAX_WEEKLY_LOSS=2500
RISK_MAX_TRADES_PER_DAY=3
RISK_MAX_OPEN_POSITIONS=2
RISK_MIN_RR=1.5
RISK_TRADING_ENABLED=false
RISK_SESSION_START=09:20
RISK_SESSION_END=15:10

# Production-only live execution gates. Keep both live flags OFF until shadow validation is complete.
CTS_LIVE_EXECUTION_ENABLED=false
CTS_LIVE_EXECUTION_CONFIRMATION=
# Production egress IP that must be whitelisted in Dhan before order APIs are enabled.
DHAN_STATIC_IP=

# Live scanner universe. Comma-separated NSE symbols; defaults to a curated liquid universe.
CTS_UNIVERSE_SYMBOLS=
# Research assumptions (not broker charges; tune from your actual contract notes).
RESEARCH_SLIPPAGE_BPS=5
RESEARCH_FEE_BPS_PER_SIDE=3
RESEARCH_STAMP_DUTY_BPS_PER_SIDE=0
