# Required service authentication
TRADINGAGENTS_SERVICE_TOKEN=replace-with-a-long-random-secret

# Pick one LLM provider supported by TradingAgents
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# TradingAgents configuration
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.6
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.6-luna
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_LLM_MAX_RETRIES=3
TRADINGAGENTS_MAX_TOKENS=8192
